{
  "name": "shulboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && node scripts/check-boundaries.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test:db": "bash scripts/test-db.sh",
    "test:db-types": "bash scripts/check-db-types.sh",
    "gen:db-types": "bash scripts/generate-db-types.sh",
    "test:routes": "node scripts/test-routes.mjs",
    "test": "npm run test:db && npm run test:db-types && npm run test:widgets && npm run test:hebrew && npm run test:chabad-adapter && npm run test:geocoding && npm run test:zmanim-fallback && npm run test:bundle && npm run build && npm run test:routes && npm run test:editor && npm run test:display && npm run test:realtime && npm run test:font-parity && npm run test:sizing && npm run test:hebrew-widgets",
    "test:editor": "node scripts/test-editor.mjs",
    "test:sizing": "node scripts/test-sizing.mjs",
    "test:widgets": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-widgets.ts",
    "test:hebrew": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-hebrew.ts",
    "test:hebrew-widgets": "node scripts/test-hebrew-widgets.mjs",
    "test:chabad-adapter": "node --conditions=react-server --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-chabad-adapter.ts",
    "test:zmanim-fallback": "node --conditions=react-server --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-zmanim-fallback.ts",
    "test:display": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-display.mjs",
    "test:realtime": "node scripts/test-realtime.mjs",
    "test:font-parity": "node scripts/test-font-parity.mjs",
    "test:bundle": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-bundle.ts",
    "test:geocoding": "node --conditions=react-server --disable-warning=ExperimentalWarning --experimental-strip-types scripts/test-geocoding.ts"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "@hebcal/learning": "^6.11.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.115.0",
    "jose": "^6.2.12",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "server-only": "^0.0.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@supabase/postgrest-typegen": "^0.2.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "playwright-core": "^1.63.0",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
